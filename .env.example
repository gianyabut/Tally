# Copy to .env.local and fill in there. This template is committed — keep it blank.

# ---- Supabase ----
# Project Settings -> Data API (URL) and API Keys (publishable/secret).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — client-safe. Legacy anon key also works
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used for admin tasks (seeding, privileged reads). Bypasses RLS.
SUPABASE_SECRET_KEY=

# ---- App ----
# Absolute base URL, used to build the OAuth redirect (auth callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (invites) — Resend ----
RESEND_API_KEY=
# Verified "from" address for invite emails.
INVITE_FROM_EMAIL=Tally <invites@example.com>
